# Copy this file to .env.local and fill in the values from the Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and configuration.
# Without these, the app keeps the cellar in the browser only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Label reading with Gemini needs Firebase AI Logic and App Check.
# The reCAPTCHA site key registered for the web app under App Check.
# Without it, the app works but has no "Read label" step.
VITE_APPCHECK_SITE_KEY=
# "enterprise" (default) or "v3", matching the provider chosen in App Check.
VITE_APPCHECK_PROVIDER=
